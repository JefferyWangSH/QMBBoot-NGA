/*
<%
setup_pybind11(cfg)
cfg['compiler_args'] = ['-std=c++20', '-O3']
cfg['include_dirs'] = ['@REPO_ROOT@']
%>
*/

#include "compiler/cpp/hubbard_kernel.hpp"
#include "operators/cpp/majorana_mask.hpp"

#include <pybind11/pybind11.h>

#include <utility>

namespace py = pybind11;
using MajoranaMonomial = qmbboot::operators::MajoranaMonomial<@L@>;
using qmbboot::operators::majorana::words_to_mask;

namespace {

py::object sym_canon(const MajoranaMonomial& monomial, bool sign) {
    auto result = qmbboot::compiler::hubbard::sym_canon<@L@>(monomial);
    if (!result.has_value()) {
        return py::none();
    }

    auto [canon, canon_sign] = std::move(*result);
    auto canon_mask = words_to_mask(canon.words());
    if (sign) {
        return py::make_tuple(canon_mask, canon_sign);
    }
    return canon_mask;
}

}  // namespace

PYBIND11_MODULE(@MODULE_NAME@, m) {
    m.doc() = "JIT C++ Hubbard compiler kernels";

    m.def("sym_canon", &sym_canon, py::arg("monomial"), py::arg("sign") = false);
}
