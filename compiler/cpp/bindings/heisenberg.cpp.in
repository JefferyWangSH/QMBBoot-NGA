/*
<%
setup_pybind11(cfg)
cfg['compiler_args'] = ['-std=c++20', '-O3']
cfg['include_dirs'] = ['@REPO_ROOT@']
%>
*/

#include "compiler/cpp/kernels/heisenberg.hpp"
#include "operators/cpp/py_mask.hpp"

#include <pybind11/pybind11.h>

namespace py = pybind11;
using PauliString = qmbboot::operators::PauliString<@L@>;
using qmbboot::operators::py_mask::words_to_mask;

namespace {

py::int_ sym_canon(const PauliString& pstr) {
    auto canon = qmbboot::compiler::heisenberg::sym_canon<@L@>(pstr);
    return words_to_mask(canon.words());
}

}  // namespace

PYBIND11_MODULE(@MODULE_NAME@, m) {
    m.doc() = "JIT C++ Heisenberg compiler kernels";

    m.def("sym_canon", &sym_canon, py::arg("pstr"));
}
