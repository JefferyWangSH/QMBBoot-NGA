/*
<%
setup_pybind11(cfg)
cfg['compiler_args'] = ['-std=c++20', '-O3', '-mpopcnt', '-fopenmp']
cfg['linker_args'] = ['-fopenmp']
cfg.setdefault('include_dirs', [])
cfg['include_dirs'].append('@REPO_ROOT@')
%>
*/

#include "compiler/cpp/core/hubbard_square.hpp"

#include <pybind11/complex.h>
#include <pybind11/numpy.h>
#include <pybind11/pybind11.h>
#include <pybind11/stl.h>

#include <cstdint>
#include <stdexcept>
#include <string>
#include <vector>

namespace py = pybind11;
using qmbboot::compiler::core::Complex;
using qmbboot::compiler::core::HubbardSquareWardCharge;
using qmbboot::compiler::core::LinearExprBatch;
using qmbboot::compiler::core::MomentsLookup;
using HubbardSquareCompilerCore = qmbboot::compiler::core::HubbardSquareCompilerCore<@LX@, @LY@>;
using MajoranaMonomialSquare = HubbardSquareCompilerCore::MajoranaMonomialSquare;

namespace {

template <class T>
py::array_t<T> to_array(const std::vector<T>& vec) {
    return py::array_t<T>(vec.size(), vec.data());
}

HubbardSquareWardCharge to_ward_charge(const std::string& charge) {
    if (charge == "hamil") return HubbardSquareWardCharge::hamil;
    if (charge == "Nu") return HubbardSquareWardCharge::number_up;
    if (charge == "Nd") return HubbardSquareWardCharge::number_dn;
    if (charge == "S+") return HubbardSquareWardCharge::spin_plus;
    if (charge == "eta+") return HubbardSquareWardCharge::eta_plus;
    throw std::invalid_argument("unknown Ward charge " + charge);
}

}  // namespace

PYBIND11_MODULE(@MODULE_NAME@, m) {
    m.doc() = "JIT C++ square-lattice Hubbard compiler core";

    py::class_<HubbardSquareCompilerCore>(m, "HubbardSquareCompilerCore")
        .def(
            py::init<const std::vector<MajoranaMonomialSquare>&, const std::vector<Complex>&, bool>(),
            py::arg("hamil_monomials"), py::arg("hamil_coeffs"), py::arg("use_ph_sym")
        )
        .def("vars", &HubbardSquareCompilerCore::vars)
        .def("build_vars", [](HubbardSquareCompilerCore& core, const std::vector<MajoranaMonomialSquare>& basis) {
            MomentsLookup moments;
            {
                py::gil_scoped_release release;
                moments = core.build_vars(basis);
            }
            return py::make_tuple(
                to_array(moments.pair_offsets), to_array(moments.pair_sizes),
                to_array(moments.rs), to_array(moments.idxs), to_array(moments.coeffs)
            );
        }, py::arg("basis"))
        .def("build_ward_identities", [](const HubbardSquareCompilerCore& core, const std::string& charge) {
            const auto ward_charge = to_ward_charge(charge);
            LinearExprBatch batch;
            {
                py::gil_scoped_release release;
                batch = core.build_ward_identities(ward_charge);
            }
            return py::make_tuple(to_array(batch.offsets), to_array(batch.idxs), to_array(batch.coeffs));
        }, py::arg("charge"))
        .def("compile_expr", [](
            const HubbardSquareCompilerCore& core,
            const std::vector<MajoranaMonomialSquare>& monomials,
            const std::vector<Complex>& coeffs
        ) -> py::object {
            const auto expr = core.compile_expr(monomials, coeffs);
            if (!expr) {
                return py::none();
            }
            std::vector<std::int32_t> idxs;
            std::vector<Complex> expr_coeffs;
            for (const auto& [idx, coeff] : expr->terms) {
                idxs.push_back(idx);
                expr_coeffs.push_back(coeff);
            }
            return py::make_tuple(to_array(idxs), to_array(expr_coeffs));
        }, py::arg("monomials"), py::arg("coeffs"))
        .def("descendants", &HubbardSquareCompilerCore::descendants, py::arg("monomial"));
}
