/*
<%
setup_pybind11(cfg)
cfg['compiler_args'] = ['-std=c++20', '-O3']
cfg['include_dirs'] = ['@REPO_ROOT@']
%>
*/

#include "operators/cpp/pauli.hpp"
#include "operators/cpp/py_mask.hpp"

#include <pybind11/complex.h>
#include <pybind11/pybind11.h>
#include <pybind11/stl.h>

#include <array>
#include <cstddef>
#include <stdexcept>
#include <string>
#include <utility>

namespace py = pybind11;
using PauliString = qmbboot::operators::PauliString<@L@>;
using qmbboot::operators::_PAULI_X;
using qmbboot::operators::_PAULI_Y;
using qmbboot::operators::_PAULI_Z;
using qmbboot::operators::py_mask::mask_to_words;
using qmbboot::operators::py_mask::words_to_mask;

namespace {

void check_L(std::size_t L) {
    if (L != PauliString::L) {
        throw std::invalid_argument("PauliString module was compiled for a different L");
    }
}

PauliString from_mask(std::size_t L, const py::int_& mask) {
    check_L(L);
    return PauliString(mask_to_words<PauliString::n_words, PauliString::n_bits>(mask));
}

PauliString identity(std::size_t L) {
    check_L(L);
    return PauliString::identity();
}

py::int_ mask(const PauliString& pstr) {
    return words_to_mask(pstr.words());
}

py::int_ trans_canon(const PauliString& pstr) {
    return words_to_mask(pstr.trans_canon().words());
}

PauliString trans_canon_rep(const PauliString& pstr) {
    return pstr.trans_canon();
}

std::array<int, 3> parse_perm(const py::tuple& perm) {
    if (perm.size() != 3) {
        throw std::invalid_argument("Pauli permutation must have length 3");
    }

    std::array<int, 3> codes{};
    for (std::size_t idx = 0; idx < 3; ++idx) {
        const auto label = py::str(perm[idx]).cast<std::string>();
        if (label == "X") {
            codes[idx] = _PAULI_X;
        } else if (label == "Y") {
            codes[idx] = _PAULI_Y;
        } else if (label == "Z") {
            codes[idx] = _PAULI_Z;
        } else {
            throw std::invalid_argument("invalid Pauli operator: " + label);
        }
    }
    return codes;
}

PauliString permute(const PauliString& pstr, const py::tuple& perm) {
    return pstr.permute(parse_perm(perm));
}

py::tuple sign_charge(const PauliString& pstr) {
    const auto charge = pstr.sign_charge();
    return py::make_tuple(charge[0], charge[1], charge[2]);
}

py::tuple pi_rot_charge(const PauliString& pstr) {
    const auto charge = pstr.pi_rot_charge();
    return py::make_tuple(charge.first, charge.second);
}

std::string repr(const PauliString& pstr) {
    return "PauliString(L=@L@, mask=" + py::str(mask(pstr)).cast<std::string>() + ")";
}

py::ssize_t hash(const PauliString& pstr) {
    return py::hash(py::make_tuple(PauliString::L, mask(pstr)));
}

}  // namespace

PYBIND11_MODULE(@MODULE_NAME@, m) {
    m.doc() = "JIT C++ Pauli string class";

    py::class_<PauliString>(m, "PauliString")
        // construction
        .def(py::init(&from_mask), py::arg("L"), py::arg("mask") = py::int_(0))
        .def_static("from_str", &PauliString::from_string, py::arg("pstr"))
        .def_static("identity", &identity, py::arg("L"))

        // data
        .def_property_readonly("L", [](const PauliString&) { return PauliString::L; })
        .def_property_readonly("mask", &mask)

        // physical properties
        .def("parity", &PauliString::parity)
        .def("sign_charge", &sign_charge)
        .def("pi_rot_charge", &pi_rot_charge)

        // physical/symmetry operations
        .def("translate", &PauliString::translate)
        .def_property_readonly("trans_canon", &trans_canon)
        .def_property_readonly("trans_canon_rep", &trans_canon_rep)
        .def_property_readonly("period", &PauliString::period)
        .def("invert", &PauliString::invert)
        .def("permute", &permute, py::arg("perm"))
        .def("mul", &PauliString::mul)
        .def("dag", &PauliString::dag)

        // Python protocol
        .def("__str__", &PauliString::to_string)
        .def("__repr__", &repr)
        .def("__hash__", &hash)
        .def("__eq__", [](const PauliString& a, const PauliString& b) {
            return a == b;
        });
}
