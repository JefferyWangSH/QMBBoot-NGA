/*
<%
setup_pybind11(cfg)
cfg['compiler_args'] = ['-std=c++20', '-O3']
cfg.setdefault('include_dirs', [])
cfg['include_dirs'].append('@REPO_ROOT@')
%>
*/

#include "operators/cpp/majorana_square.hpp"
#include "operators/cpp/py_mask.hpp"

#include <pybind11/complex.h>
#include <pybind11/pybind11.h>
#include <pybind11/stl.h>

#include <cstddef>
#include <stdexcept>
#include <string>
#include <utility>

namespace py = pybind11;
using MajoranaMonomialSquare = qmbboot::operators::MajoranaMonomialSquare<@LX@, @LY@>;
using qmbboot::operators::py_mask::mask_to_words;
using qmbboot::operators::py_mask::words_to_mask;

namespace {

void check_shape(std::size_t Lx, std::size_t Ly) {
    if (Lx != MajoranaMonomialSquare::Lx || Ly != MajoranaMonomialSquare::Ly) {
        throw std::invalid_argument("MajoranaMonomialSquare module was compiled for a different Lx, Ly");
    }
}

MajoranaMonomialSquare from_mask(std::size_t Lx, std::size_t Ly, const py::int_& mask) {
    check_shape(Lx, Ly);
    return MajoranaMonomialSquare(
        mask_to_words<MajoranaMonomialSquare::n_words, MajoranaMonomialSquare::n_modes>(mask)
    );
}

py::object from_str(std::size_t Lx, std::size_t Ly, const std::string& s, bool sign) {
    check_shape(Lx, Ly);
    auto [monomial, total_sign] = MajoranaMonomialSquare::from_string(s);
    if (sign) {
        return py::make_tuple(std::move(monomial), total_sign);
    }
    return py::cast(std::move(monomial));
}

MajoranaMonomialSquare identity(std::size_t Lx, std::size_t Ly) {
    check_shape(Lx, Ly);
    return MajoranaMonomialSquare::identity();
}

py::int_ mask(const MajoranaMonomialSquare& monomial) {
    return words_to_mask(monomial.words());
}

py::object fermion_parity(const MajoranaMonomialSquare& monomial, bool spin) {
    const auto parity = monomial.fermion_parity();
    if (spin) {
        return py::make_tuple(parity.first, parity.second);
    }
    return py::cast((parity.first + parity.second) & 1);
}

py::int_ trans_canon(const MajoranaMonomialSquare& monomial) {
    return words_to_mask(monomial.trans_canon().first.words());
}

int trans_canon_sign(const MajoranaMonomialSquare& monomial) {
    return monomial.trans_canon().second;
}

MajoranaMonomialSquare trans_canon_rep(const MajoranaMonomialSquare& monomial) {
    return monomial.trans_canon().first;
}

std::string repr(const MajoranaMonomialSquare& monomial) {
    return "MajoranaMonomialSquare(Lx=@LX@, Ly=@LY@, mask="
        + py::str(mask(monomial)).cast<std::string>() + ")";
}

py::ssize_t hash(const MajoranaMonomialSquare& monomial) {
    return py::hash(py::make_tuple(MajoranaMonomialSquare::Lx, MajoranaMonomialSquare::Ly, mask(monomial)));
}

}  // namespace

PYBIND11_MODULE(@MODULE_NAME@, m) {
    m.doc() = "JIT C++ square-lattice Majorana monomial class";

    py::class_<MajoranaMonomialSquare>(m, "MajoranaMonomialSquare")
        // construction
        .def(py::init(&from_mask), py::arg("Lx"), py::arg("Ly"), py::arg("mask") = py::int_(0))
        .def_static("from_str", &from_str, py::arg("Lx"), py::arg("Ly"), py::arg("s"), py::arg("sign") = false)
        .def_static("identity", &identity, py::arg("Lx"), py::arg("Ly"))

        // data
        .def_property_readonly("Lx", [](const MajoranaMonomialSquare&) { return MajoranaMonomialSquare::Lx; })
        .def_property_readonly("Ly", [](const MajoranaMonomialSquare&) { return MajoranaMonomialSquare::Ly; })
        .def_property_readonly("n_sites", [](const MajoranaMonomialSquare&) { return MajoranaMonomialSquare::n_sites; })
        .def_property_readonly("mask", &mask)

        // physical properties
        .def("degree", &MajoranaMonomialSquare::degree)
        .def("dag_phase", &MajoranaMonomialSquare::dag_phase)
        .def("hermitian_phase", &MajoranaMonomialSquare::hermitian_phase)
        .def("fermion_parity", &fermion_parity, py::arg("spin") = false)
        .def("k_parity", &MajoranaMonomialSquare::k_parity, py::arg("hermitian") = true)
        .def("ph_parity", &MajoranaMonomialSquare::ph_parity)

        // physical/symmetry operations
        .def("mul", &MajoranaMonomialSquare::mul)
        .def("translate", &MajoranaMonomialSquare::translate, py::arg("shift_x"), py::arg("shift_y"))
        .def_property_readonly("trans_canon", &trans_canon)
        .def_property_readonly("trans_canon_sign", &trans_canon_sign)
        .def_property_readonly("trans_canon_rep", &trans_canon_rep)
        .def("trans_stabilizer", &MajoranaMonomialSquare::trans_stabilizer)
        .def("lattice_c4_rotate", &MajoranaMonomialSquare::lattice_c4_rotate, py::arg("quarters"))
        .def("lattice_reflect_x", &MajoranaMonomialSquare::lattice_reflect_x)
        .def("majorana_c4_rotate", &MajoranaMonomialSquare::majorana_c4_rotate, py::arg("up_quarters"), py::arg("dn_quarters"))
        .def("spin_exchange", &MajoranaMonomialSquare::spin_exchange)

        // Python protocol
        .def("__str__", &MajoranaMonomialSquare::to_string)
        .def("__repr__", &repr)
        .def("__hash__", &hash)
        .def("__eq__", [](const MajoranaMonomialSquare& a, const MajoranaMonomialSquare& b) {
            return a == b;
        });
}
